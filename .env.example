DB_PATH=./data/automation.db
CRM_DB_HOST=47.236.9.71
CRM_DB_PORT=3918
CRM_DB_NAME=enterprise
CRM_DB_USER=root
CRM_DB_PASSWORD=***
CRM_BASE_URL=http://47.236.9.71:8310/enterprise-admin
CRM_USERNAME=Hermes
CRM_PASSWORD=***

# Minimal WhatsApp webhook callback service + deployable official-group bridge service
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replac...oken
OFFICIAL_GROUP_BRIDGE_TOKEN=replace-with-bridge-token
OFFICIAL_GROUP_BRIDGE_MODE=mock_success
OFFICIAL_GROUP_BRIDGE_MAX_REQUESTS=200
OFFICIAL_GROUP_BRIDGE_UPSTREAM_URL=
OFFICIAL_GROUP_BRIDGE_UPSTREAM_TOKEN=
OFFICIAL_GROUP_BRIDGE_TIMEOUT_SECONDS=20

# Hermes backend -> official group approval webhook bridge
OFFICIAL_GROUP_APPROVAL_EXECUTOR_KIND=webhook
OFFICIAL_GROUP_APPROVAL_WEBHOOK_URL=https://example.com/official-group/approve
OFFICIAL_GROUP_APPROVAL_WEBHOOK_TOKEN=***
OFFICIAL_GROUP_APPROVAL_WEBHOOK_TIMEOUT_SECONDS=20

# High-concurrency ingress settings
INGRESS_ASYNC_DEFAULT=true
INGRESS_WORKER_ENABLED=true
INGRESS_WORKER_POLL_INTERVAL=0.5
INGRESS_RATE_LIMIT_PER_MINUTE=600
EXTERNAL_CALL_RATE_LIMIT_PER_MINUTE=300
ALLOW_LIVE_BIND_SIMULATION=false

# Linky CMS SID bind / keepalive. Store real tokens in data/cms_keepalive.env, not in source.
# LINKE_CMS_ACCOUNTS_JSON=[{"name":"Permata","guild_id":"413","guild_sid":"25400979","authorization":"replace_with_cms_authorization_jwt"}]
CMS_KEEPALIVE_TIMEOUT_SECONDS=30

# Planned infra migration targets
POSTGRES_DSN=postgresql://mcn:***@127.0.0.1:5432/mcn_automation
REDIS_URL=redis://127.0.0.1:6379/0

# Free self-hosted LibreTranslate option. Set provider=libretranslate to avoid paid AI APIs.
GROUP_ATMOSPHERE_TRANSLATOR_PROVIDER=libretranslate
LIBRETRANSLATE_BASE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=

# Optional OpenAI-compatible translator for better contextual translation. Leave API key empty to avoid paid AI APIs.
GROUP_ATMOSPHERE_TRANSLATOR_API_KEY=
GROUP_ATMOSPHERE_TRANSLATOR_BASE_URL=https://api.openai.com/v1
GROUP_ATMOSPHERE_TRANSLATOR_MODEL=gpt-4o-mini
GROUP_ATMOSPHERE_TRANSLATOR_TIMEOUT_SECONDS=20
